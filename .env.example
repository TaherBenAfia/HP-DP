# Copy to .env for local overrides. Never commit real secrets.

# --- Sharing / authentication ---------------------------------------------
# false = local open mode (no token required); true = JWT validation enforced
SHARING_REQUIRE_AUTH=false
# HS256 secret used when no JWKS/issuer is configured (min 32 chars)
SHARING_JWT_SECRET=
# Keycloak-style issuer and JWKS endpoint for RS256 validation
OIDC_ISSUER=http://localhost:8080/realms/enterprise
SHARING_JWKS_URL=

# --- API / dashboard -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
STREAMLIT_SERVER_PORT=8501

# --- Lakehouse / orchestration / observability -----------------------------
# Apache Polaris REST catalog (leave empty to use the local SQLite catalog)
POLARIS_URI=
POLARIS_TOKEN=
POLARIS_CREDENTIAL=
# Temporal server address (empty = in-process activities, no server required)
TEMPORAL_ADDRESS=
# ClickHouse OLAP sink (empty = disabled)
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# DSPy language model (empty = deterministic offline LM)
DSPY_LM_MODEL=

# --- Dataset ---------------------------------------------------------------
DATASET_ID=sports_seo_tunisia_v1
