# Normalize line endings to LF in the repository, checkout as-is on Windows
* text=auto eol=lf

# Explicitly binary — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.parquet binary
*.db binary
*.duckdb binary

# Lock files — preserve exactly
uv.lock text eol=lf
